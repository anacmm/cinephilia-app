# Copy to .env (ignored by Git). PostgreSQL needs the actual password;
# Spring Boot can use its Jasypt-encrypted ENC(...) equivalent.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=castquest
DB_USERNAME=castquest
DB_PASSWORD=
POSTGRES_PASSWORD=
# Supply JASYPT_ENCRYPTOR_PASSWORD separately, as for the existing TMDB key.
# Optional: DB_URL overrides DB_HOST, DB_PORT and DB_NAME for the application.
# DB_URL=jdbc:postgresql://localhost:5432/castquest
